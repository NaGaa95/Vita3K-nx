set(VITA3K_SWITCH_PGO "USE" CACHE STRING "Switch profile-guided optimization mode")
set_property(CACHE VITA3K_SWITCH_PGO PROPERTY STRINGS OFF USE)
set(VITA3K_SWITCH_PGO_DIR "" CACHE PATH "Override the bundled Switch GCC profiles")

function(vita3k_switch_configure_pgo executable)
	if(VITA3K_SWITCH_PGO STREQUAL "OFF")
		return()
	endif()
	if(NOT VITA3K_SWITCH_PGO STREQUAL "USE")
		message(FATAL_ERROR "VITA3K_SWITCH_PGO must be OFF or USE")
	endif()
	if(NOT CMAKE_C_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
			OR NOT CMAKE_C_COMPILER_VERSION VERSION_EQUAL CMAKE_CXX_COMPILER_VERSION)
		message(FATAL_ERROR "Switch PGO requires matching GCC C and C++ compilers")
	endif()
	if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
		message(FATAL_ERROR "Switch PGO requires Release; use VITA3K_SWITCH_PGO=OFF for other configurations")
	endif()

	set(_profiles "${VITA3K_SWITCH_PGO_DIR}")
	set(_trained_source "")
	if(NOT _profiles)
		set(_bundle "${CMAKE_SOURCE_DIR}/dist/switch/pgo")
		file(READ "${_bundle}/profiles.json" _bundle_metadata)
		string(JSON _expected_hash GET "${_bundle_metadata}" sha256)
		string(JSON _trained_source GET "${_bundle_metadata}" source_root)
		set(_archive "${_bundle}/vulkan.tar.xz")
		set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_bundle}/profiles.json" "${_archive}")
		file(SHA256 "${_archive}" _archive_hash)
		if(NOT _archive_hash STREQUAL _expected_hash)
			message(FATAL_ERROR "Invalid bundled Switch PGO archive: ${_archive}")
		endif()
		string(SUBSTRING "${_archive_hash}" 0 12 _key)
		set(_profiles "${CMAKE_BINARY_DIR}/pgo/vulkan-${_key}")
		if(NOT EXISTS "${_profiles}/.complete")
			file(MAKE_DIRECTORY "${_profiles}")
			file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_profiles}")
			file(WRITE "${_profiles}/.complete" "${_archive_hash}\n")
		endif()
	endif()
	if(NOT EXISTS "${_profiles}/profiles.json")
		message(FATAL_ERROR "Missing Switch GCC profile manifest in ${_profiles}")
	endif()
	file(READ "${_profiles}/profiles.json" _metadata)
	string(JSON _schema GET "${_metadata}" schema)
	string(JSON _program GET "${_metadata}" program)
	string(JSON _version GET "${_metadata}" gcc_version)
	string(JSON _count GET "${_metadata}" objects)
	file(GLOB _data "${_profiles}/data/*.gcda")
	list(LENGTH _data _actual_count)
	if(NOT _schema EQUAL 1 OR NOT _program STREQUAL "Vita3K-nx" OR NOT _count GREATER 0
			OR NOT _count EQUAL _actual_count)
		message(FATAL_ERROR "Missing or incomplete Switch GCC profiles in ${_profiles}")
	endif()
	if(NOT _version VERSION_EQUAL CMAKE_CXX_COMPILER_VERSION)
		message(FATAL_ERROR "Switch PGO profiles require GCC ${_version}; use VITA3K_SWITCH_PGO=OFF with other compilers")
	endif()
	foreach(_profile IN LISTS _data)
		get_filename_component(_name "${_profile}" NAME)
		string(JSON _expected_hash GET "${_metadata}" files "${_name}")
		file(SHA256 "${_profile}" _actual_hash)
		if(NOT _expected_hash STREQUAL _actual_hash)
			message(FATAL_ERROR "Corrupt Switch PGO data: ${_name}")
		endif()
	endforeach()
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_profiles}/profiles.json" ${_data})

	set(_prefix "${CMAKE_BINARY_DIR}")
	set(_source "${CMAKE_SOURCE_DIR}")
	if(CMAKE_HOST_SYSTEM_NAME MATCHES "MSYS|CYGWIN")
		find_program(_cygpath cygpath REQUIRED)
		execute_process(COMMAND "${_cygpath}" -aw "${CMAKE_BINARY_DIR}"
			OUTPUT_VARIABLE _prefix OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
		execute_process(COMMAND "${_cygpath}" -am "${CMAKE_SOURCE_DIR}"
			OUTPUT_VARIABLE _source OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
	elseif(CMAKE_HOST_WIN32)
		file(TO_NATIVE_PATH "${CMAKE_BINARY_DIR}" _prefix)
	endif()
	set(_mismatch -Wno-error=coverage-mismatch)
	if(_source STREQUAL _trained_source)
		set(_mismatch -Werror=coverage-mismatch)
	endif()
	set(_flags "-fprofile-prefix-path=${_prefix}" "-fprofile-use=${_profiles}/data"
		-fprofile-partial-training ${_mismatch} -Wno-missing-profile)
	target_link_options(${executable} PRIVATE ${_flags})
	foreach(_target IN ITEMS cpu mem kernel modules gxm display audio ngs ctrl motion touch io np vkutil dynarmic)
		foreach(_flag IN LISTS _flags)
			target_compile_options(${_target} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:${_flag}>")
		endforeach()
	endforeach()
	get_target_property(_sources renderer SOURCES)
	get_target_property(_directory renderer SOURCE_DIR)
	foreach(_source IN LISTS _sources)
		if(_source MATCHES "^src/(vulkan/|texture/|[^/]+[.]cpp$)")
			set_property(SOURCE "${_directory}/${_source}" TARGET_DIRECTORY renderer
				APPEND PROPERTY COMPILE_OPTIONS ${_flags})
		endif()
	endforeach()
	message(STATUS "Switch PGO: using ${_count} GCC profiles from ${_profiles}")
endfunction()
