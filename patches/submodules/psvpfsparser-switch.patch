index a23ff8619ee1cefbfadfea289b2541e4d6177ee6..05bebf705748db58efa5e974b4795a61022e7b27 100644
--- a/LocalFilesystem.h
+++ b/LocalFilesystem.h
@@ -1,5 +1,15 @@
 #pragma once
 
+// On Horizon/Switch the SD card is exposed through the newlib "sdmc:" devoptab.
+// std::filesystem (devkitA64 libstdc++) mis-parses that device-colon prefix as a
+// *relative* path, so relative()/canonical()/absolute() prepend getcwd and throw,
+// and create_directories chokes on the bare "sdmc:" component. boost::filesystem
+// (the switch-boost portlib) is already used everywhere else in the port and is
+// proven to work on these paths, so alias to it there.
+#ifdef PSVPFS_BOOST
+#include <boost/filesystem.hpp>
+namespace psvpfs = boost::filesystem;
+#else
 #include <filesystem>
-
 namespace psvpfs = std::filesystem;
+#endif
