diff --git a/CMakeLists.txt b/CMakeLists.txt
index a2fcacc11b815cc5b23367dabf85636a7f2ad958..c60a379cf085dda64892c1f1935beac3f4a0132a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2946,6 +2946,28 @@ elseif(N3DS)
   set(HAVE_SDL_LOCALE TRUE)
 
   sdl_glob_sources("${SDL3_SOURCE_DIR}/src/io/n3ds/*.c")
+elseif(NINTENDO_SWITCH)
+  # Nintendo Switch (Horizon / libnx). There is no dedicated SDL video/audio
+  # backend yet: the emulator creates its Vulkan surface directly from the libnx
+  # NWindow (VK_NN_vi_surface), so SDL video falls back to dummy, and audio is
+  # dummy until a libnx audout backend is added. Threads use pthreads (newlib/
+  # libnx), timers/time use the generic unix backends, and FS ops use posix.
+  set(SDL_PTHREADS ON)
+  CheckPTHREAD()
+
+  set(SDL_TIMER_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/timer/unix/*.c")
+  set(HAVE_SDL_TIMERS TRUE)
+
+  set(SDL_TIME_UNIX 1)
+  sdl_glob_sources("${SDL3_SOURCE_DIR}/src/time/unix/*.c")
+  set(HAVE_SDL_TIME TRUE)
+
+  # Use the dummy filesystem + dummy fsops backend (Vita3K does its own file I/O
+  # through std::filesystem). Note: the posix fsops backend must NOT be used here
+  # because the dummy filesystem backend also defines SDL_SYS_GetCurrentDirectory,
+  # which would collide at link time. Leaving HAVE_SDL_FSOPS unset makes SDL fall
+  # back to dummy fsops (see the SDL_FSOPS_DUMMY block later in this file).
 endif()
 
 sdl_sources(${SDL3_SOURCE_DIR}/src/dialog/SDL_dialog.c)
diff --git a/cmake/sdlchecks.cmake b/cmake/sdlchecks.cmake
index d321e7108d1586ccb88ed0c524d4f555172ee6ea..2247270b4d1601f1673ffb26085e962132071b5d 100644
--- a/cmake/sdlchecks.cmake
+++ b/cmake/sdlchecks.cmake
@@ -842,6 +842,11 @@ macro(CheckPTHREAD)
       set(PTHREAD_LDFLAGS "-pthread")
     elseif(QNX)
       # pthread support is baked in
+    elseif(NINTENDO_SWITCH)
+      # devkitA64 newlib/libnx provide pthreads via -lnx (already linked by the
+      # switch.specs); no separate libpthread or -pthread flag exists.
+      set(PTHREAD_CFLAGS "-D_REENTRANT")
+      set(PTHREAD_LDFLAGS "")
     else()
       set(PTHREAD_CFLAGS "-D_REENTRANT")
       set(PTHREAD_LDFLAGS "-lpthread")
